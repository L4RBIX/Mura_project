# Server-only: never prefix these secrets with NEXT_PUBLIC_.
MURA_API_URL=https://your-mura-core.example.com
MURA_CORE_API_KEY=replace-with-the-core-api-bearer-token

# Hosted fallback used when Mura Core is unavailable. Server-only.
DEEPSEEK_API_KEY=sk-replace-with-real-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
